<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>Item_paint</defName>
    <label>paint</label>
    <description>it's paint</description>
    <graphicData>
      <texPath>Items/Paint</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Metal_Drop</soundDrop>
    <stackLimit>75</stackLimit>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <MarketValue>5</MarketValue>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>2</Mass>
      <Flammability>0.2</Flammability>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <drawGUIOverlay>true</drawGUIOverlay>
    <tradeability>Sellable</tradeability>
    <techLevel>Industrial</techLevel>
    <tradeTags>
      <li>ExoticMisc</li>
    </tradeTags>
  </ThingDef>




  <ThingDef Name="Unfinishedpaintingthing" Abstract="True">
    <thingClass>UnfinishedThing</thingClass>
    <category>Item</category>
    <label>unfinished thing</label>
    <graphicData>
      <texPath>Things/Item/Unfinished/UnfinishedSculpture</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <altitudeLayer>Item</altitudeLayer>
    <useHitPoints>true</useHitPoints>
    <isUnfinishedThing>true</isUnfinishedThing>
    <scatterableOnMapGen>false</scatterableOnMapGen>
    <selectable>true</selectable>
    <tradeability>None</tradeability>
    <drawerType>MapMeshOnly</drawerType>
    <!-- For CompForbiddable -->
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <DeteriorationRate>2.0</DeteriorationRate>
      <Beauty>-8</Beauty>
      <Mass>1</Mass> <!-- ingredients are added to this value -->
    </statBases>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Styleable"/>
    </comps>
    <alwaysHaulable>true</alwaysHaulable>
    <rotatable>false</rotatable>
    <pathCost>14</pathCost>
    <thingCategories>
      <li>Unfinished</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="Unfinishedpaintingthing">
    <defName>Unfinishedpainting</defName>
    <label>unfinished painting</label>
    <description>An unfinished painting.</description>
    <graphicData>
      <texPath>Items/Unfinished_painting</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
  </ThingDef>












</Defs>