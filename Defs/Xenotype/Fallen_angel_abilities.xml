<?xml version="1.0" encoding="utf-8"?>
<Defs>
 <AbilityDef>
    <defName>angelLongjump</defName>
    <label>angelic flight</label>
    <description>Fly a short distance using the power of the wings. It uses no hemogen to do this</description>
    <iconPath>UI/Abilities_Icon/FallenAngelLongJump</iconPath>
    <cooldownTicksRange>60</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <verbProperties>
      <verbClass>Verb_CastAbilityJump</verbClass>
      <label>jump</label>
      <violent>false</violent>
      <forceNormalTimeSpeed>false</forceNormalTimeSpeed>
      <warmupTime>0.5</warmupTime>
      <range>19.9</range>
      <requireLineOfSight>true</requireLineOfSight>
      <soundCast>angel_take_off</soundCast>
      <soundLanding>Longjump_Land</soundLanding>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <jobDef>CastJump</jobDef>
  </AbilityDef>

  <AbilityDef ParentName="AbilityTouchBase">
    <defName>AngelResurrect</defName>
    <label>resurrect</label>
    <description>inject highly concentrated hemogen in the bloodstream to infuse a corpse's body with new life, repairing degenerated cell structures and kickstarting vital functions. The older and worse-preserved the corpse is, the more likely it is that they will come back with memory loss or health conditions. This ability to exhaust all the supply of hemogen and it can only be used very rarely.</description>
    <iconPath>UI/Abilities_Icon/FallenAngelResurrect</iconPath>
    <cooldownTicksRange>1840000~2560000</cooldownTicksRange>
    <warmupMote>Mote_ResurrectAbility</warmupMote>
    <warmupStartSound>Resurrect_Cast</warmupStartSound>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <category>Sanguophage</category>
    <displayOrder>600</displayOrder>
    <hostile>false</hostile>
    <verbProperties>
      <verbClass>Verb_CastAbilityTouch</verbClass>
      <drawAimPie>false</drawAimPie>
      <range>-1</range>
      <warmupTime>2</warmupTime>
      <soundCast>Resurrect_Resolve</soundCast>
      <targetParams>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetCorpses>true</canTargetCorpses>
        <canTargetMechs>false</canTargetMechs>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_Resurrect" />
      <li Class="CompProperties_AbilityHemogenCost">
        <hemogenCost>0.90</hemogenCost>
      </li>
      <li Class="CompProperties_AbilitySocialInteraction">
        <interactionDef>Angelresurrected</interactionDef>
        <canApplyToUnconscious>true</canApplyToUnconscious>
      </li>
    </comps>
    
  </AbilityDef>

 <InteractionDef>
    <defName>Angelresurrected</defName>
    <label>licked clean</label>
    <workerClass>InteractionWorker</workerClass>
    <ignoreTimeSinceLastInteraction>True</ignoreTimeSinceLastInteraction>
    <symbol>UI/Motes/Alive</symbol>
    <recipientThought>angel_ressurected_me</recipientThought>
    <logRulesInitiator>
      <rulesStrings>
        <li>r_logentry(p=4)->[INITIATOR_nameDef] resurrected [RECIPIENT_nameDef]</li>
        <li>r_logentry->[INITIATOR_nameDef] resurrected [RECIPIENT_nameDef] "took you long enough" said [RECIPIENT_nameDef]</li>
        <li>r_logentry->[INITIATOR_nameDef] resurrected [RECIPIENT_nameDef] "curse you, I was enjoying my rest" said [RECIPIENT_nameDef]</li>
      </rulesStrings>
    </logRulesInitiator>
  </InteractionDef>

  <ThoughtDef>
    <defName>angel_ressurected_me</defName>
    <showBubble>true</showBubble>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>20</durationDays>
    <stackLimit>1</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <socialTargetDevelopmentalStageFilter>Baby, Child, Adult</socialTargetDevelopmentalStageFilter>
    <stages>
      <li>
        <label>Cleaned my wounds</label>
        <baseOpinionOffset>20</baseOpinionOffset>
      </li>
    </stages>
    <thoughtToMake>angel_ressurected_me_mood</thoughtToMake>
  </ThoughtDef>

  <ThoughtDef>
    <defName>angel_ressurected_me_mood</defName>
    <durationDays>2</durationDays>
    <stackLimit>10</stackLimit>
    <stackedEffectMultiplier>0.9</stackedEffectMultiplier>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>Alive</label>
        <description>Wow! I'm Alive</description>
        <baseMoodEffect>10</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>





