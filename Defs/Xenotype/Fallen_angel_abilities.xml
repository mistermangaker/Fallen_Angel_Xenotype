<AbilityDef>
   <defName>Chu_WordOfJoy</defName>
    <label>Chu (kiss)</label>
    <description>Kiss them right on the cheek and wash all of those worries away. angel have the ability to wash away all of your worries with a single kiss</description>
    <jobDef>CastAbilityOnThingMelee</jobDef>
    <iconPath>UI/Abilities_Icon/FallenAngelWordOfJoy</iconPath>
     <cooldownTicksRange>1000</cooldownTicksRange>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
