		</graphicData>-->
  
  </GeneDef>




 <GeneDef>
    <defName>angelResurrect</defName>
    <label>resurrect</label>
    <description>Carriers have a reserve of sapecial hemogen in them which can be infused into a corpse, rebuild degenerated tissue and kickstart the vital processes. This brings the dead back to life - though possibly with health issues. This can only be done very rarely, and comes at a steep hemogen cost.</description>
    <iconPath>UI/Gene_Icons/FallenAngelResurrect</iconPath>
    <displayCategory>Angel_genes</displayCategory>
    <marketValueFactor>1.5</marketValueFactor>
    <prerequisite>Hemogenic</prerequisite>
    <abilities>
      <li>AngelResurrect</li>
    </abilities>
    <descriptionHyperlinks>
      <AbilityDef>Resurrect</AbilityDef>
    </descriptionHyperlinks>
    <biostatCpx>4</biostatCpx>
    <biostatMet>-2</biostatMet>
    <minAgeActive>3</minAgeActive>
    <symbolPack>
      <wholeNameSymbols>
        <li><symbol>resurrector</symbol></li>
      </wholeNameSymbols>
      <prefixSymbols>
        <li><symbol>life</symbol></li>
      </prefixSymbols>
    </symbolPack>
  </GeneDef>

 <GeneDef>
    <defName>angelwordoflove</defName>
    <label>Natural Match Maker</label>
    <description>Carriers of this gene have an almost supernatural ability to make people fall in love and develop crushes on other people.</description>
    <iconPath>UI/Gene_Icons/FallenAngelWordOfLove</iconPath>
    <displayCategory>Angel_genes</displayCategory>
    <marketValueFactor>1.5</marketValueFactor>
    <prerequisite>Hemogenic</prerequisite>
    <abilities>
      <li>AngelWordOfLove</li>
    </abilities>
    <biostatCpx>4</biostatCpx>
    <biostatMet>-2</biostatMet>
    <minAgeActive>3</minAgeActive>
    <symbolPack>
      <wholeNameSymbols>
        <li><symbol>resurrector</symbol></li>
      </wholeNameSymbols>
      <prefixSymbols>
        <li><symbol>life</symbol></li>
      </prefixSymbols>
    </symbolPack>
  </GeneDef>

 <GeneDef>
    <defName>angelwordofjoy</defName>
    <label>Blessed Kiss</label>
    <description>Carriers of this gene seem to have an almost supernatural ability to calm people down and brighten their day with just a single kiss.</description>
    <iconPath>UI/Gene_Icons/FallenAngelWordOfJoy</iconPath>
    <displayCategory>Angel_genes</displayCategory>
    <marketValueFactor>1.5</marketValueFactor>
    <prerequisite>Hemogenic</prerequisite>
    <abilities>
      <li>Chu_WordOfJoy</li>
    </abilities>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <minAgeActive>16</minAgeActive>
    <symbolPack>
      <wholeNameSymbols>
        <li><symbol>resurrector</symbol></li>
      </wholeNameSymbols>
      <prefixSymbols>
        <li><symbol>life</symbol></li>
      </prefixSymbols>
    </symbolPack>
  </GeneDef>

	<GeneDef ParentName="GeneEarsBase">
		<defName>FallenAngel_Horns</defName>
		<label>Horns</label>
		<description>These adorable little horns are the unmistakable trait of fallen angels. Don't mind the horns. Don't they look cute?</description>
		<iconPath>UI/Gene_Icons/FallenAngelHorns</iconPath>
		<displayCategory>Angel_genes</displayCategory>
		<biostatMet>0</biostatMet>
		<biostatCpx>0</biostatCpx>
    <renderNodeProperties>
      <li>
        <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
        <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
        <texPath>Humanlike/BodyParts/Horns/FallenAngelHorns</texPath>
        <color>(255, 255, 255)</color>
        <parentTagDef>Head</parentTagDef>
        <drawData>
          <defaultData>
            <layer>80</layer>
          </defaultData>
          <dataNorth>
            <layer>10</layer>
          </dataNorth>
        </drawData>
      </li>
    </renderNodeProperties>

	</GeneDef>

	<GeneDef  ParentName="GeneHairStyleBase">
		<defName>FallenAngel_Hair</defName>
		<label>Angel Hair</label>
		<displayCategory>Angel_genes</displayCategory>
		<description>byeah</description>
		<iconPath>UI/Gene_Icons/FallenAngelHair</iconPath>
		<biostatCpx>0</biostatCpx>
		<biostatMet>0</biostatMet>
		<hairTagFilter>
			<whitelist>true</whitelist>
			<tags>
				<li>Fallen_angel</li>
			</tags>
		</hairTagFilter>
	</GeneDef>


  <GeneDef ParentName="GeneTailBase">
    <defName>AngelTail_Smooth</defName>
    <label>angelic tail</label>
    <description>This forked tail is a natural trait of fallen angels. It swings back and forth when fallen angels are happy and excited... or preparing to feast on souls.</description>
    <iconPath>UI/Gene_Icons/FallenAngelTail</iconPath>
    <displayOrderInCategory>1023</displayOrderInCategory>
    <capMods>
      <li>
        <capacity>Manipulation</capacity>
        <offset>0.05</offset>
      </li>
    </capMods>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <displayCategory>Angel_genes</displayCategory>
        <renderNodeProperties>
      <li>
        <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
        <texPath>Humanlike/BodyParts/Tail/FallenAngelTail</texPath>
        
        <overrideMeshSize>(1, 1)</overrideMeshSize>
        <parentTagDef>Body</parentTagDef>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <drawData>
          <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
          <defaultData>
            <layer>-2</layer>
          </defaultData>
          <dataNorth>
            <offset>(0, 0, -0.15)</offset>
            <layer>90</layer>
          </dataNorth>
          <dataSouth>
            <offset>(-0, 0, -0.15)</offset>
          </dataSouth>
          <dataEast>
            <offset>(-0.5, 0, -0.15)</offset>
          </dataEast>
          <dataWest>
            <offset>(0.5, 0, -0.15)</offset>
          </dataWest>
        </drawData>
      </li>
    </renderNodeProperties>

  </GeneDef>

 <GeneDef>
    <defName>BloodAcidSpray</defName>
    <label>acidic blood spray</label>
    <description>Carriers grow glands in the neck that generate and store a sticky acid substance, along with acid-tolerant tissues in the mouth. They can spew this acid over an area, where it will stick to enemies and burn them over time.</description>
    <iconPath>UI/Gene_Icons/FallenAngelBloodSpray</iconPath>
    <displayCategory>Angel_genes</displayCategory>
    <marketValueFactor>1.5</marketValueFactor>
    <damageFactors>
      <BloodBurn>0.25</BloodBurn>
    </damageFactors>
    <abilities>
      <li>AngelBloodSpray</li>
    </abilities>
    <descriptionHyperlinks>
      <AbilityDef>AcidSpray</AbilityDef>
    </descriptionHyperlinks>
    <biostatMet>-2</biostatMet>
  </GeneDef>


 <GeneDef>
    <defName>angelgreatasstes</defName>
    <label>Great Assets</label>
    <description>Carriers have very attractive bodies.</description>
    <iconPath>UI/Gene_Icons/FallenAngelGreatAssets</iconPath>
    <displayCategory>Angel_genes</displayCategory>
    <marketValueFactor>1.5</marketValueFactor>
    <statOffsets>
      <SocialImpact>2</SocialImpact>
      <PawnBeauty>1</PawnBeauty>
    </statOffsets>
    <biostatCpx>1</biostatCpx>
    <biostatMet>1</biostatMet>
    <minAgeActive>16</minAgeActive>
    
  </GeneDef>

  <GeneDef ParentName="GeneVoiceBase">
    <defName>AngelVoice</defName>
    <label>angelic voice</label>
    <description>Carriers have an extremely pleasant sounding voice. As a result they become </description>
    <iconPath>UI/Gene_Icons/FallenAngelAngelicVoice</iconPath>
    <displayOrderInCategory>126</displayOrderInCategory>
    <statOffsets>
      <TameAnimalChance>0.5</TameAnimalChance>
      <NegotiationAbility>0.5</NegotiationAbility>
      <TradePriceImprovement>0.7</TradePriceImprovement>
      
    </statOffsets>
    <soundCall>Angel_Call</soundCall>
    <soundDeath>Angel_death</soundDeath>
    <soundWounded>Angel_hurt</soundWounded>

  </GeneDef>


 <GeneDef>
    <defName>AngelHealingSaliva</defName>
    <label>healing saliva</label>
    <description>Carriers saliva is infused with hemogen, when the saliva is ingested or applied directly onto a wound it acts as a disinfecant</description>
    <iconPath>UI/Gene_Icons/FallenAngelHealingSpit</iconPath>
    <displayCategory>Angel_genes</displayCategory>
    <marketValueFactor>1.5</marketValueFactor>
    <abilities>
      <li>LickyLicky</li>
    </abilities>
    
    <biostatMet>-2</biostatMet>
  </GeneDef>

 

</Defs>