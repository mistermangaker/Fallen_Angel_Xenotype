<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ScenarioDef>
    <defName>shamiaSanguophage</defName>
    <label>The Angel Cult</label>
    <description>Throughout the land there exist creatures that mimic angels in their appearance. These creatures are extremely charismatic and powerful. They form small cults surrounding themseleves. This is the story of one of those cults going out into the wilderness in search of a new home.</description>
    <scenario>
      <summary>start with 1 angel and 5 colonists and starting supplies</summary>
      <playerFaction>
        <def>PlayerFaction</def>
                <factionDef>PlayerColony</factionDef>

      </playerFaction>
      <parts>

        <!-- Config pages -->
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes">
          <def>ConfigurePawnsXenotypes</def>
          <pawnChoiceCount>6</pawnChoiceCount>
          <customSummary>start with 1 angel and 5 colonists and starting supplies</customSummary>
          <overrideKinds>
            <li>
              <xenotype>Fallen_angel</xenotype>
              <pawnKind>ShamiaColonist</pawnKind>
            </li>
            <li>
              <xenotype>gremlins</xenotype>
              <pawnKind>GremlinColonist</pawnKind>
            </li>
          </overrideKinds>
          <xenotypeCounts>
            <li>
              <xenotype>Fallen_angel</xenotype>
              <count>1</count>
              <description>non-babyfallen angel</description>
              <requiredAtStart>true</requiredAtStart>
              <allowedDevelopmentalStages>Adult, Child</allowedDevelopmentalStages>
            </li>
            <li>
              <xenotype>gremlins</xenotype>
              <count>5</count>
            </li>
          </xenotypeCounts>
        </li>

        <!-- Player starting stuff spawn method-->
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
        </li>

        <!-- Game start dialog -->
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>Throughout the land there exist creatures that mimic angels in their appearance. These creatures are extremely charismatic and powerful. They form small cults surrounding themseleves. This is the story of one of those cults going out into the wilderness in search of a new home.</text>
          <closeSound>GameStartSting</closeSound>
        </li>

        <!-- Player starting things -->
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Silver</thingDef>
          <count>2000</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MealSurvivalPack</thingDef>
          <count>100</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>HemogenPack</thingDef>
          <count>30</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineIndustrial</thingDef>
          <count>20</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>ComponentIndustrial</thingDef>
          <count>10</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>WoodLog</thingDef>
          <count>200</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Steel</thingDef>
          <count>200</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MeleeWeapon_LongSword</thingDef>
          <quality>Masterwork</quality>
          <stuff>Steel</stuff>
        </li>

        <!-- Starting research -->


      </parts>
    </scenario>
  </ScenarioDef>


  <ScenarioDef>
    <defName>fallencult</defName>
    <label>The Failed Angel Cult</label>
    <description>Throughout the land there exist creatures that mimic angels in their appearance. These creatures are extremely charismatic and powerful. They form small cults surrounding themseleves. This is the story of one of those cults going out into the wilderness in search of a new home. It would seem like this particular journey didnt go as planned.</description>
    <scenario>
      <summary>start with 1 angel and 2 colonists and little supplies</summary>
      <playerFaction>
        <def>PlayerFaction</def>
        <factionDef>PlayerColony</factionDef>
      </playerFaction>
      <parts>

        <!-- Config pages -->
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes">
          <def>ConfigurePawnsXenotypes</def>
          <pawnChoiceCount>3</pawnChoiceCount>
          <customSummary>start with 1 angel and 2 colonists and little supplies</customSummary>
          <overrideKinds>
            <li>
              <xenotype>Fallen_angel</xenotype>
              <pawnKind>ShamiaColonist</pawnKind>
            </li>
            <li>
              <xenotype>gremlins</xenotype>
              <pawnKind>GremlinColonist</pawnKind>
            </li>
          </overrideKinds>
          <xenotypeCounts>
            <li>
              <xenotype>Fallen_angel</xenotype>
              <count>1</count>
              <description>non-baby fallen angel</description>
              <requiredAtStart>true</requiredAtStart>
              <allowedDevelopmentalStages>Adult, Child</allowedDevelopmentalStages>
            </li>
            <li>
              <xenotype>gremlins</xenotype>
              <count>2</count>
            </li>
          </xenotypeCounts>
        </li>

        <!-- Game start dialog -->
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>Throughout the land there exist creatures that mimic angels in their appearance. These creatures are extremely charismatic and powerful. They form small cults surrounding themseleves. This is the story of one of those cults going out into the wilderness in search of a new home. It would seem like this particular journey didnt go as planned.</text>
          <closeSound>GameStartSting</closeSound>
        </li>
                <!-- Player starting stuff spawn method-->
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
        </li>

        <!-- Player pawns modifiers -->
        <li Class="ScenPart_ForcedHediff">
          <def>ForcedHediff</def>
          <visible>false</visible>
          <context>PlayerStarter</context>
          <chance>0.5</chance>
          <hediff>Malnutrition</hediff>
          <severityRange>0.2~0.4</severityRange>
        </li>
        
        <li Class="ScenPart_SetNeedLevel">
          <def>SetNeedLevel</def>
          <visible>false</visible>
          <context>PlayerStarter</context>
          <chance>1.0</chance>
          <need>Food</need>
          <levelRange>0~0.1</levelRange>
        </li>
        <li Class="ScenPart_SetNeedLevel">
          <def>SetNeedLevel</def>
          <visible>false</visible>
          <context>PlayerStarter</context>
          <chance>1.0</chance>
          <need>Mood</need>
          <levelRange>0.2~0.5</levelRange>
        </li>
        <li Class="ScenPart_SetNeedLevel">
          <def>SetNeedLevel</def>
          <visible>false</visible>
          <context>PlayerStarter</context>
          <chance>1.0</chance>
          <need>Rest</need>
          <levelRange>0.0~0.1</levelRange>
        </li>



        <!-- Player starting things -->
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Silver</thingDef>
          <count>200</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MealSurvivalPack</thingDef>
          <count>10</count>
        </li>
        
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineIndustrial</thingDef>
          <count>3</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>ComponentIndustrial</thingDef>
          <count>10</count>
        </li>
        
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MeleeWeapon_LongSword</thingDef>
          <quality>Masterwork</quality>
          <stuff>Steel</stuff>
        </li>


      </parts>
    </scenario>
  </ScenarioDef>
</Defs>